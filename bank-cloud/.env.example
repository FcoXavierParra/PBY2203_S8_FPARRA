# ===========================================================================
# Plantilla de configuracion por entorno para docker-compose.yaml
# ===========================================================================
# Copiar a .env (que NO se publica: esta en .gitignore y .dockerignore) y
# completar. Compose lo lee solo, desde la carpeta donde esta el compose.
#
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# oracle   Autonomous Database, un esquema por servicio (por defecto)
# default  H2 en memoria dentro de cada contenedor: solo para probar sin la
#          ADB. En ese modo CUENTAS_REPLICAS debe ser 1 (ver el compose).
PERFIL_BD=oracle

# Carpeta del wallet de la ADB, FUERA del proyecto (nunca se versiona ni entra
# a la imagen). Se monta de solo lectura en /wallet de cada microservicio.
WALLET_DIR=/home/ubuntu/wallet

# El TNS_ADMIN apunta a donde queda el wallet DENTRO del contenedor.
# <servicio>: el nombre en tnsnames.ora terminado en _low (ver el README).
ORACLE_JDBC_URL=jdbc:oracle:thin:@<servicio>_low?TNS_ADMIN=/wallet

# Una clave por esquema, las que se definieron al ejecutar
# herramientas/usuarios_oracle_s8.sql.
CLAVE_BANK_CUENTAS=
CLAVE_BANK_TRANSF=
CLAVE_BANK_AUDIT=

# ---------------------------------------------------------------------------
# Escalado
# ---------------------------------------------------------------------------
CUENTAS_REPLICAS=2

# ---------------------------------------------------------------------------
# TLS de los BFF
# ---------------------------------------------------------------------------
BFF_KEYSTORE_PASSWORD=
